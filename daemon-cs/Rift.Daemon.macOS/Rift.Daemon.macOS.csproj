<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rift.Daemon.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>osx</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.151.0" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rift.Daemon.Core\Rift.Daemon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\com.rift.daemon.plist" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\RiftDaemon.Info.plist" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\MediaRemoteAdapter\**\*" CopyToOutputDirectory="PreserveNewest" Link="MediaRemoteAdapter\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="Tools\build_macos_daemon_app.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\install_launchagent.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
