<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>rift-notification-extractor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rift.Daemon.Tests" />
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>macos13.0</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Native\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\com.rift.notification-extractor.plist" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\RiftNotificationExtractor.Info.plist" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\*.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
