{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift.local/spec/capstone-doc-spec.schema.json",
  "title": "Rift Capstone Documentation Contract",
  "type": "object",
  "required": [
    "spec_version",
    "source",
    "classification",
    "reports",
    "workbooks",
    "source_ambiguities"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "spec_version": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "source_catalog": { "type": "object", "additionalProperties": true },
    "classification": { "$ref": "#/$defs/classification" },
    "reports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/report" }
    },
    "workbooks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/workbook" }
    },
    "cross_document_traceability": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/trace_rule" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/trace_rule" }
        }
      ]
    },
    "cross_document_orphan_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/orphan_rule" }
    },
    "source_ambiguities": {
      "type": "array",
      "items": { "$ref": "#/$defs/ambiguity" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["authority", "documents"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "documents": { "type": "array", "items": { "type": "string" } },
        "inspection_notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "object",
      "properties": {
        "placeholder_patterns": { "$ref": "#/$defs/patterns" },
        "instruction_patterns": { "$ref": "#/$defs/patterns" },
        "sample_fingerprints": { "$ref": "#/$defs/patterns" }
      },
      "additionalProperties": true
    },
    "patterns": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "pattern": { "type": "string", "minLength": 1 },
              "regex": { "type": "string", "minLength": 1 },
              "multiline": { "type": "boolean" },
              "dotall": { "type": "boolean" },
              "applies_to": { "type": "array", "items": { "type": "string" } },
              "rationale": { "type": "string" }
            },
            "oneOf": [
              { "required": ["pattern"] },
              { "required": ["regex"] }
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "report": {
      "type": "object",
      "required": ["title", "sections"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "short_name": { "type": "string" },
        "source_file": { "type": "string" },
        "source_files": { "type": "array", "items": { "type": "string" } },
        "source_requirement": { "type": "string" },
        "final_state": { "type": "boolean" },
        "trace_entities": { "type": "object", "additionalProperties": true },
        "sections": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/section" }
        }
      },
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": ["title", "requirement"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "level": { "type": "integer", "minimum": 1 },
        "requirement": { "enum": ["MUST", "SHOULD", "MAY", "CONDITIONAL"] },
        "source_requirement": { "type": "string" },
        "heading_required": { "type": "boolean" },
        "content": {
          "oneOf": [
            { "type": "boolean" },
            { "$ref": "#/$defs/content_rule" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/evidence_rule" }
            ]
          }
        },
        "repeatable": { "type": "boolean" },
        "per_feature_required": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "additionalProperties": true }
          ]
        },
        "match": { "$ref": "#/$defs/match_rule" },
        "condition": { "$ref": "#/$defs/condition" },
        "allow_explicit_na": { "type": "boolean" },
        "min_occurrences": { "type": "integer", "minimum": 0 },
        "children": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/section" }
        }
      },
      "additionalProperties": false
    },
    "content_rule": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "allow_explicit_na": { "type": "boolean" },
        "scope": { "enum": ["section", "subtree"] }
      },
      "additionalProperties": true
    },
    "evidence_rule": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "semantic_review": { "type": "boolean" },
        "description": { "type": "string" },
        "min": { "type": "integer", "minimum": 0 },
        "source_requirement": { "type": "string" }
      },
      "additionalProperties": true
    },
    "workbook": {
      "type": "object",
      "required": ["source_file", "purpose", "sheets"],
      "properties": {
        "source_file": { "type": "string" },
        "short_name": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 },
        "required_sheets": { "type": "array", "items": { "type": "string" } },
        "optional_sheets": { "type": "array", "items": { "type": "string" } },
        "sheet_patterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/sheet_pattern" }
        },
        "sheets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sheet_rule" }
        },
        "observed_schema": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "trace_rule": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "handler": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_domain": { "type": "string", "minLength": 1 },
        "source_report": { "type": "string", "minLength": 1 },
        "source_kind": { "type": ["string", "array"] },
        "source_kinds": { "type": "array", "items": { "type": "string" } },
        "entity_kind": { "type": ["string", "array"] },
        "targets": {
          "oneOf": [
            { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/trace_target" }] } },
            { "type": "object", "additionalProperties": true }
          ]
        },
        "target_domains": { "type": ["array", "object"] },
        "requirement": { "enum": ["MUST", "SHOULD", "MAY", "CONDITIONAL"] },
        "freshness": { "type": ["boolean", "object"] },
        "target_domain": { "type": "string" }
      },
      "additionalProperties": true
    },
    "trace_target": {
      "type": "object",
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "target_domain": { "type": "string", "minLength": 1 },
        "report": { "type": "string", "minLength": 1 },
        "kind": { "type": ["string", "array"] },
        "kinds": { "type": "array", "items": { "type": "string" } },
        "target_kind": { "type": ["string", "array"] },
        "requirement": { "enum": ["MUST", "SHOULD", "MAY", "CONDITIONAL"] },
        "condition": {},
        "applicability": {},
        "allow_explicit_na": { "type": "boolean" },
        "role": { "type": "string" },
        "stage": { "type": "string" }
      },
      "additionalProperties": true
    },
    "orphan_rule": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "source_domain": { "type": "string" },
        "source_report": { "type": "string" },
        "source_kind": { "type": ["string", "array"] },
        "source_kinds": { "type": "array", "items": { "type": "string" } },
        "target": { "type": "string" },
        "target_domain": { "type": "string" },
        "target_report": { "type": "string" },
        "target_kind": { "type": ["string", "array"] },
        "target_kinds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "severity": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sheet_rule": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "min": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" },
        "header_rows": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "required_columns": { "type": "array", "items": { "type": "string" } },
        "required_labels": { "type": "array", "items": { "type": "string" } },
        "label_rows": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "min_real_data_rows": { "type": "integer", "minimum": 0 },
        "content_required": { "type": "boolean" },
        "ignore_for_content": { "type": "boolean" },
        "enforce_allowed_values": { "type": "boolean" },
        "allowed_values": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": ["string", "number", "boolean", "null"] }
          }
        },
        "merged_regions": { "type": "array", "items": { "type": "string" } },
        "sample_row_signatures": {
          "type": "object",
          "required": ["rows"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": ["string", "number", "boolean", "null"]
                }
              }
            }
          },
          "additionalProperties": false
        },
        "layout": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "sheet_pattern": {
      "allOf": [
        { "$ref": "#/$defs/sheet_rule" },
        { "type": "object", "required": ["pattern"] }
      ]
    },
    "match_rule": {
      "type": "object",
      "required": ["regex"],
      "properties": {
        "regex": { "type": "string", "minLength": 1 },
        "exclude_prefixes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/boolean_condition" },
        { "$ref": "#/$defs/text_condition" },
        { "$ref": "#/$defs/section_present_condition" },
        { "$ref": "#/$defs/unknown_condition" }
      ]
    },
    "boolean_condition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["true", "always_true", "false", "always_false"] }
      },
      "additionalProperties": false
    },
    "text_condition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["document_contains_any", "document_contains", "document_contains_none", "document_not_contains"] },
        "pattern": { "type": "string", "minLength": 1 },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "anyOf": [
        { "required": ["pattern"] },
        { "required": ["patterns"] }
      ],
      "additionalProperties": false
    },
    "section_present_condition": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": { "const": "section_present" },
        "title": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "unknown_condition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "unknown" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },

    "ambiguity": {
      "type": "object",
      "required": ["id", "status", "resolution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved", "informational"] },
        "resolution": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
